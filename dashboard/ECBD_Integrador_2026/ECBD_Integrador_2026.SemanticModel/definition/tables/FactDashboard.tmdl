table FactDashboard
	lineageTag: 5f6b18d6-45e3-4c18-a6d1-fbbaa2048151

	measure Observaciones = FORMAT([Total observaciones], "#,##0", "en-US")
		lineageTag: 53b2ffe9-5368-4208-8c09-9e285baa59e9

	measure Categorias = DISTINCTCOUNT(FactDashboard[NObeyesdad])
		formatString: #,##0
		lineageTag: 02675ef4-194d-4c85-9466-e43bddf73483

	measure 'Edad promedio' = AVERAGE(FactDashboard[Age])
		formatString: 0.0
		lineageTag: b4926227-a76f-4126-8de8-df9784da1f84

	measure 'Peso prom. (kg)' = AVERAGE(FactDashboard[Weight])
		formatString: 0.0
		lineageTag: 11e58070-2e0d-4250-911a-328861e470c2

	measure 'Estatura promedio (m)' = AVERAGE(FactDashboard[Height])
		formatString: 0.00
		lineageTag: 469c151a-f27a-4ebb-8532-c2e35c2d1c6e

	measure 'Total observaciones' = COUNTROWS(FactDashboard)
		formatString: #,##0
		lineageTag: 5b322ec4-059a-49c0-a57c-535c7bc7f166

	measure 'Observaciones (texto)' = FORMAT([Observaciones], "#,##0", "en-US")
		lineageTag: d985ce10-6f51-49d3-ba4b-8eb7ccbe9c4b

	column Gender
