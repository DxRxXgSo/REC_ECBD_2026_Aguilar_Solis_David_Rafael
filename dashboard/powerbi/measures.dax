-- Tabla: FactDashboard (fuente CSV, con cluster/PC1/PC2 anexados por row_index)
Total observaciones = COUNTROWS(FactDashboard)
Observaciones = FORMAT([Total observaciones], "#,##0", "en-US")
Categorias = DISTINCTCOUNT(FactDashboard[NObeyesdad])
Edad promedio = AVERAGE(FactDashboard[Age])
Peso prom. (kg) = AVERAGE(FactDashboard[Weight])
Estatura promedio (m) = AVERAGE(FactDashboard[Height])
-- Tabla: ModelMetrics. En la tabla mostrar filas task/scenario/model y métricas
-- con cuatro decimales. El gráfico de página 2 muestra F1 macro por
-- escenario y modelo, evitando promediar modelos distintos.
Accuracy = MAX(ModelMetrics[test_accuracy])
Precision macro = MAX(ModelMetrics[test_precision_macro])
Recall macro = MAX(ModelMetrics[test_recall_macro])
F1 macro = MAX(ModelMetrics[test_f1_macro])
MAE = MAX(ModelMetrics[test_mae])
RMSE = MAX(ModelMetrics[test_rmse])
R cuadrada = MAX(ModelMetrics[test_r2])

-- Tabla: PcaVariance
Varianza explicada = SUM(PcaVariance[explained_variance_ratio])
